[Unit]
Description=Download RDS from S3 on startup
After=network.target
Before=fastapi.service

[Service]
Type=oneshot
User=ec2-user
EnvironmentFile=/home/ec2-user/backend/.env
ExecStart=/home/ec2-user/backend/venv/bin/python3 /home/ec2-user/backend/download_rds.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target